    "assistantScript": [
      { "q": "什么是牛顿第二定律？", "a": "牛顿第二定律表述为 F = ma，即物体加速度与所受合外力成正比，与质量成反比，加速度方向与合外力方向相同。它是连接力学与运动学的核心公式。" },
      { "q": "加速度的方向跟谁相同？", "a": "加速度方向与合外力方向相同，而不是与速度方向相同。这点常被混淆：减速时加速度方向与运动方向相反，但与合外力方向一致。", "keywords": ["加速度", "方向"] },
      { "q": "为什么要用合外力？", "a": "牛顿第二定律中的 F 是合外力，即所有作用在物体上的力的矢量和。如果只考虑某一个力，加速度计算就会出错。", "keywords": ["合外力", "F"] },
      { "q": "实验中弹簧测力计显示什么？", "a": "弹簧测力计通过弹簧形变量反映所受拉力大小，是验证 F = ma 关系的经典演示工具。本课演示中，教师通过不同质量物体的拉伸对比直观展示了力与质量的反比关系。", "keywords": ["实验", "弹簧", "测力计"] }
    ]
  },
