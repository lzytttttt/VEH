      {
        "id": "k2", "title": "牛顿第二定律",
        "category": "力学·牛顿定律",
        "summary": "物体加速度的大小与合外力成正比，与质量成反比，方向与合外力相同：F = ma。",
        "details": "数学表达式 F = ma，其中 F 为合外力（单位 N），m 为物体质量（单位 kg），a 为加速度（单位 m/s²）。这是连接力学与运动学的桥梁：已知力可求运动状态，已知运动可反推合外力。瞬时性：力与加速度同时存在同时消失。",
        "related": ["k1", "k3", "k4", "k5"],
        "classroomRefs": [
          { "t": 30, "type": "板书", "label": "F=ma 公式推导" },
          { "t": 90, "type": "实验", "label": "弹簧测力计演示" },
          { "t": 150, "type": "总结", "label": "公式回顾" }
        ]
      },
      {
        "id": "k3", "title": "牛顿第三定律（作用与反作用）",
        "category": "力学·牛顿定律",
        "summary": "两个物体之间的作用力与反作用力大小相等、方向相反、作用在同一直线上。",
        "details": "作用力与反作用力分别作用在两个不同物体上，不能抵消。它们同时产生、同时变化、同时消失，且性质相同。下节课将重点学习。",
        "related": ["k2"],
        "classroomRefs": [{ "t": 150, "type": "预告", "label": "下节课预告" }]
      },
      {
        "id": "k4", "title": "加速度",
        "category": "运动学",
        "summary": "加速度是速度变化率，描述速度随时间的变化，矢量，单位 m/s²。",
        "details": "a = Δv / Δt。加速度方向决定速度变化方向，而非运动方向。当加速度与速度同向时物体加速，反向时减速。在牛顿第二定律中加速度方向始终与合外力方向一致。",
        "related": ["k2", "k5"],
        "classroomRefs": [{ "t": 40, "type": "讲解", "label": "加速度方向讨论" }]
      },
      {
        "id": "k5", "title": "力的合成",
        "category": "力学·力",
        "summary": "多个力同时作用在物体上时，可等效为一个合外力。",
        "details": "同一直线上力的合成：代数加减；互成角度的力用平行四边形定则或正交分解法求解。牛顿第二定律中的 F 指的是合外力，而非单个力。",
        "related": ["k2", "k4"],
        "classroomRefs": [{ "t": 35, "type": "讲解", "label": "合外力概念" }]
      }
