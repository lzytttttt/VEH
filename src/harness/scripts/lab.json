    "assistantScript": [
      { "q": "滴定管为什么要润洗？", "a": "润洗是为了避免管内残留的水稀释待装液，保证浓度准确。具体做法是用待装液润洗 2-3 次，每次少量，转动滴定管使内壁全部润湿后从下端放出。" },
      { "q": "如何进行半滴操作？", "a": "接近终点时，轻转活塞让液滴悬在管口不落下，将锥形瓶内壁靠过去接触液滴，再用蒸馏水冲洗内壁。这是保证精度低于 0.1% 误差的关键技巧。", "keywords": ["半滴", "终点"] },
      { "q": "中和反应的本质是什么？", "a": "本质是 H+ 与 OH- 结合生成水：H+ + OH- = H2O。这是放热反应，因此在滴定过程中温度会略有上升。", "keywords": ["中和", "本质"] },
      { "q": "c1V1=c2V2 何时成立？", "a": "当反应按化学计量数完全进行且计量比为 1:1 时成立（如强酸强碱 1:1 反应）。若是 H2SO4 与 NaOH，应写作 c(酸)×V(酸)×2 = c(碱)×V(碱)。", "keywords": ["计算", "公式"] }
